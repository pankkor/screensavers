set expandtab
set shiftwidth=2
set colorcolumn=80
set list

let &l:makeprg="cd ".g:localvimrc_script_dir_unresolved." && ./build.sh"

if !exists('*s:build_and_run_current_file')
  function! s:build_and_run_current_file()
    let l:full = expand('%')
    let l:root = expand('%:t:r')
    execute 'make --no-test ' . fnameescape(l:full)
    execute '!./build/' . fnameescape(l:root)
  endfunction
endif

nnoremap <F2> :call <SID>build_and_run_current_file()<CR>
